from src.utils import load_json_file, save_json_file

class LLMEvaluator:
    def __init__(self, data_path: str):
        self.test_cases = load_json_file(data_path)

    def evaluate_case(self, case: dict) -> dict:
        output = case.get("model_output", "")
        keywords = case.get("expected_keywords", [])
        min_len = case.get("min_length", 0)

        # Keyword match validation
        found_keywords = [kw for kw in keywords if kw.lower() in output.lower()]
        keyword_score = len(found_keywords) / len(keywords) if keywords else 1.0

        # Length requirement check
        length_passed = len(output) >= min_len

        # Final Status
        passed = (keyword_score >= 0.8) and length_passed

        return {
            "id": case["id"],
            "prompt": case["prompt"],
            "passed": passed,
            "keyword_accuracy_score": round(keyword_score, 2),
            "length_check": length_passed
        }

    def run_evaluations(self, output_report_path: str):
        results = [self.evaluate_case(tc) for tc in self.test_cases]
        summary = {
            "total_tests": len(results),
            "passed_tests": sum(1 for r in results if r["passed"]),
            "details": results
        }
        save_json_file(summary, output_report_path)
        return summary
