import os
from src.evaluator import LLMEvaluator

def main():
    print("--- Starting AI Output Evaluation Engine ---")
    
    data_file = os.path.join("data", "test_cases.json")
    report_file = os.path.join("reports", "evaluation_results.json")
    
    evaluator = LLMEvaluator(data_file)
    summary = evaluator.run_evaluations(report_file)
    
    print(f"Evaluation Complete!")
    print(f"Total Tests: {summary['total_tests']} | Passed: {summary['passed_tests']}")

if __name__ == "__main__":
    main()
